# ==================== 服务器基础配置 ====================
# 运行环境
NODE_ENV=development
PORT=3000
HOST=localhost
TRUST_PROXY=1

# ==================== 安全配置 ====================
# 会话密钥 (生产环境建议使用: openssl rand -base64 48)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_48_chars
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=fraud_platform_session

# JWT 密钥 (用于管理员认证)
JWT_SECRET=replace_with_jwt_secret_change_in_production

# Cookie 安全设置
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS 设置 (同源部署可留空;跨域管理端才填写逗号分隔的完整来源)
CORS_ORIGIN=

# ==================== 管理员认证 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ==================== URLTime SSO 统一登录 ====================
# URLTime 认证服务地址
URLTIME_AUTH_BASE_URL=https://login.urltime.cn/api/v1
URLTIME_AUTH_TIMEOUT_MS=10000

# SSO 客户端配置
URLTIME_SSO_CLIENT_ID=fraud-detection-platform
URLTIME_SSO_CLIENT_SECRET=replace_with_shared_secret
URLTIME_SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback

# SSO 会话配置
SSO_STATE_COOKIE_NAME=fraud_platform_sso_state
SSO_STATE_TTL_SECONDS=600

# ==================== AI 模型配置 ====================
# 模型类型选择
DEFAULT_MODEL_TYPE=local
# 可选值: local (本地模型) | cloud (云端模型)

# 本地模型设置
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:latest
LOCAL_MODEL_API_KEY=

# 云端模型设置 (可使用 Geek2API 等服务)
CLOUD_MODEL_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL_NAME=gpt-4
CLOUD_MODEL_API_KEY=your_api_key_here

# Geek2API 配置 (可选,支持多节点轮询)
GEEK2API_KEY=
GEEK2API_BASE_URLS=https://www.geek2api.com/v1,https://hk.geek2api.com/v1,https://api.geek2api.com/v1
GEEK2API_MODELS=glm-5.3-flash,gemini-3.8-flash
GEEK2API_TIMEOUT_MS=20000

# 模型参数
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000
DEFAULT_THINKING_EFFORT=medium
# 可选值: low, medium, high, xhigh

# ==================== UAPI 配置 ====================
# UAPI 通用 API 服务
UAPI_API_KEY=
UAPI_TIMEOUT_MS=10000
# 获取 API 密钥: https://uapis.cn

# ==================== 雪球 API 配置 ====================
# 雪球财务数据服务
XUEQIU_TIMEOUT_MS=10000

# ==================== 翻译服务配置 (可选) ====================
# DeepLX 翻译服务
DEEPLX_API_KEY=
DEEPLX_API_BASE_URL=https://api.deeplx.org
DEEPLX_TRANSLATE_URL=
TRANSLATION_TIMEOUT_MS=10000

# 腾讯云机器翻译 TMT (与 DeepLX 二选一或同时配置)
TENCENT_TMT_SECRET_ID=
TENCENT_TMT_SECRET_KEY=
TENCENT_TMT_REGION=ap-guangzhou
TENCENT_TMT_ENDPOINT=tmt.tencentcloudapi.com
TENCENT_TMT_TOKEN=

# ==================== 速率限制配置 ====================
# API 调用速率限制
API_RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=20

# ==================== 系统配置 ====================
# 日志级别
LOG_LEVEL=info
# 可选值: error, warn, info, debug

# 数据保留天数
LOG_RETENTION_DAYS=30
SESSION_CLEANUP_INTERVAL_HOURS=24

# ==================== 开发环境配置 ====================
# 开发模式设置
DEBUG=false
VERBOSE_LOGGING=false

# 热重载
AUTO_RELOAD=true

# ==================== 生产环境注意事项 ====================
# 生产部署时请务必:
# 1. 修改 NODE_ENV=production
# 2. 生成新的 SESSION_SECRET 和 JWT_SECRET
# 3. 设置 COOKIE_SECURE=true
# 4. 配置真实的 URLTIME_SSO_CLIENT_SECRET
# 5. 更新 URLTIME_SSO_REDIRECT_URI 为生产域名
# 6. 修改管理员密码
# 7. 配置云端模型 API 密钥
# 8. 启用 HTTPS
